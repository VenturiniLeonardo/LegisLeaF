# Copy to .env (or export in your shell) and fill in. Never commit .env.
# LegisLeaF does not read .env by itself: load it with your shell or tooling,
# e.g. `set -a; . ./.env; set +a`.

# OpenAI-compatible endpoint serving the LLM and the SLM.
# Local server (vLLM, TensorRT-LLM, llama.cpp...):
OPENAI_BASE_URL=http://localhost:8080/v1
# Remote provider, e.g. OpenRouter:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# API key. A local server usually accepts any value.
# OPENROUTER_API_KEY is used when OPENAI_API_KEY is not set.
OPENAI_API_KEY=
# OPENROUTER_API_KEY=<your-key>

# Model names as exposed by the endpoint on /v1/models.
LLM_MODEL_NAME_DEFAULT=nvidia/nemotron-3-super
SLM_MODEL_NAME_DEFAULT=qwen3-classifier

# Sentence-transformers encoder for few-shot retrieval (F1) and its device.
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cuda

# Optional: let LegisLeaF start/stop the model servers with Docker Compose.
# Leave empty to manage the servers yourself.
DOCKER_COMPOSE_FILE=

# Optional: Akoma Ntoso XSD for validating the F2 XML (requires the `xsd` extra).
AKN_XSD_PATH=
