  "structure_conventions": {
    "_commento": [
      "Convenzioni tipografiche della redazione italiana. I valori riproducono",
      "esattamente il comportamento che f2 aveva quando erano costanti nel codice.",
      "article_rubric_position='after': numero e rubrica stanno sulla stessa riga",
      "('Art. 5 Definizioni'), e quando l'OCR le separa la rubrica e' il blocco",
      "breve che SEGUE l'intestazione."
    ],
    "article_rubric_position": "after",
    "article_rubric_max_words": 30,
    "rubric_block_types": [],
    "rubric_lookahead_blocks": 3,
    "contents_page_min_headings": 5,
    "contents_page_min_ratio": 0.5,
    "running_header_max_page_order": 2,
    "running_header_min_pages": 3,
    "recital_sequence_tolerance": 3
  }
